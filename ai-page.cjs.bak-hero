const img=(n,caption)=>({file:`assets/2026/${n}.jpg`,caption});

module.exports=function renderAI(p,{shell,photo,esc}){
 const base='../../';
 const picture=(im,cls='')=>`<button class="ai-picture ${cls}" data-image="${base+im.file}" data-caption="${esc(im.caption)}" aria-label="放大查看：${esc(im.caption)}"><img src="${base+im.file}" alt="${esc(im.caption)}" loading="lazy" decoding="async"></button>`;
 const ppt=[1,2,3,4,5].map((n,i)=>img(`s2_${n}`,['政企项目汇报','教育合作方案','产品方案汇报','产品能力与场景','产品服务方案'][i]));
 const audiences=[['Government','政府','政策价值 / 建设目标 / 合作价值','从政策方向、区域需求与合作价值出发，建立决策者能够快速理解的汇报主线。'],['School','学校','产品能力 / 校园场景 / 实施路径','将产品能力映射到学校真实场景，说明实施方式、协同关系与预期价值。'],['Teacher','教师','教学使用 / 操作流程 / 实际效果','围绕教学任务和操作步骤重写内容，降低理解门槛，帮助教师开始实践。']];
 const flow=['需求背景','建设目标','产品能力','应用场景','阶段成果','合作价值'];
 const versions=[['V1',img('s3_1','产品版本更新宣传页 01'),'建立清晰的信息入口'],['V2',img('s3_2','产品版本更新宣传页 02'),'突出功能变化与使用价值'],['V3',img('s3_3','产品版本更新宣传页 03'),'用场景语言降低理解成本']];
 const body=`<article class="ai-case">
 <section class="ai-hero" id="ai-top"><div class="ai-hero-copy"><a class="ai-back" href="../../index.html#work">← 返回核心项目</a><p class="ai-label">01 / AI EDUCATION</p><h1>让复杂的 <span>AI 产品</span><br>变得更容易<br><span>理解与使用</span></h1><p class="ai-lede">参与 AI+基础教育产品传播、政企汇报、校园推广及教师赋能项目，通过信息梳理、内容结构设计与视觉表达，将复杂产品能力转化为适用于不同受众的传播内容。</p><div class="ai-pills">${['Content Strategy','Product Communication','ToB / ToG','Presentation','Project Delivery'].map(t=>`<span>${t}</span>`).join('')}</div></div><div class="ai-canvas" aria-label="AI 教育项目视觉组合"><div class="ai-glow"></div>${picture(img('s2_4','产品能力与应用场景梳理'),'ai-float ai-main')}${picture(img('s3_1','产品版本更新宣传页'),'ai-float ai-left')}${picture(img('s3_9','教师培训与操作指导'),'ai-float ai-right')}${picture(img('s4_1','AI 教师赋能活动视觉'),'ai-float ai-bottom')}</div></section>
 <div class="ai-transition" aria-hidden="true"></div>
 <section class="ai-overview ai-wrap ai-reveal"><p class="ai-label">ABOUT THE PROJECT</p><div><h2>如何针对政府、学校与教师，把复杂 AI 教育产品转换为可汇报、可理解、可培训的内容？</h2><dl><div><dt>ROLE</dt><dd>产品运营 / 内容策划 / 视觉表达</dd></div><div><dt>SCOPE</dt><dd>ToG / ToB / Campus / Teacher Training</dd></div><div><dt>OUTPUT</dt><dd>PPT / Promotion / Campaign / Training</dd></div></dl></div></section>
 <section class="ai-impact"><div class="ai-wrap"><p class="ai-label">SELECTED IMPACT</p><div class="ai-impact-grid">${p.results.map(([v,l])=>`<div><strong data-ai-count="${esc(v)}">${esc(v)}</strong><span>${esc(l)}</span></div>`).join('')}</div></div></section>
 <section class="ai-audience ai-wrap"><header class="ai-section-head ai-reveal"><p class="ai-label">THE COMMUNICATION CHALLENGE</p><h2>同一套产品，<br>面对三种不同的沟通对象。</h2></header><div class="ai-audience-panels">${audiences.map(([en,cn,keys,text],i)=>`<button class="ai-audience-card" type="button" aria-expanded="${i===0}"><span class="ai-card-no">0${i+1}</span><span class="ai-card-en">${en}</span><strong>${cn}</strong><span class="ai-card-keys">${keys}</span><span class="ai-card-text">${text}</span></button>`).join('')}</div></section>
 <section class="ai-translation"><div class="ai-wrap ai-story"><div class="ai-story-copy"><p class="ai-label">FROM COMPLEXITY TO CLARITY</p><h2>从复杂信息到清晰表达</h2><p>不是减少信息，而是重新设计信息出现的顺序、层级和语言。</p><nav aria-label="内容转译步骤">${['原始资料','结构重建','最终传播'].map((t,i)=>`<a href="#ai-story-${i+1}" data-story-link="${i+1}"><span>0${i+1}</span>${t}</a>`).join('')}</nav></div><div class="ai-story-visuals">
  <section class="ai-story-step" id="ai-story-1" data-story-step="1"><div class="ai-step-copy"><span>STEP 01 / RAW INFORMATION</span><h3>先看见信息的复杂度</h3><p>产品能力复杂、资料来源分散，首先完成资料整理和价值提炼。</p></div><div class="ai-raw">${picture(img('s3_5','产品介绍与功能说明'))}${picture(img('s2_1','政企汇报材料'))}${picture(img('s3_7','产品版本更新与功能说明'))}</div></section>
  <section class="ai-story-step" id="ai-story-2" data-story-step="2"><div class="ai-step-copy"><span>STEP 02 / STRUCTURE</span><h3>建立一条可以被理解的主线</h3><p>让汇报从问题出发，经过能力与场景，最终落到合作价值。</p></div><ol class="ai-flow">${flow.map((t,i)=>`<li><span>0${i+1}</span><b>${t}</b></li>`).join('')}</ol></section>
  <section class="ai-story-step" id="ai-story-3" data-story-step="3"><div class="ai-step-copy"><span>STEP 03 / COMMUNICATION</span><h3>把结构转化成不同载体</h3><p>政企汇报、教师培训与产品介绍拥有不同阅读场景，但共享同一条价值逻辑。</p></div><div class="ai-final-comms">${picture(ppt[3])}${picture(img('s3_9','教师培训与操作指导'))}${picture(img('s3_1','产品版本更新宣传页'))}</div></section>
 </div></div></section>
 <section class="ai-presentation ai-wrap"><header class="ai-section-head ai-reveal"><p class="ai-label">FEATURED PRESENTATION</p><h2>不是增加装饰，<br>而是重新建立信息层级。</h2></header><div class="ai-featured">${picture(ppt[0],'ai-featured-main')}</div><div class="ai-film-head"><span>SELECTED SLIDES / DRAG TO EXPLORE</span><div><button type="button" data-film-prev aria-label="上一张">←</button><button type="button" data-film-next aria-label="下一张">→</button></div></div><div class="ai-film" tabindex="0">${ppt.slice(1).map(im=>picture(im)).join('')}</div></section>
 <section class="ai-versions"><div class="ai-wrap"><header class="ai-section-head ai-reveal"><p class="ai-label">PRODUCT COMMUNICATION</p><h2>把产品更新翻译成使用价值</h2></header><div class="ai-version-stack">${versions.map(([v,im,note],i)=>`<article class="ai-version" style="--version:${i}"><div><span>${v}</span><p>${note}</p></div>${picture(im)}</article>`).join('')}</div></div></section>
 <section class="ai-field ai-wrap"><header class="ai-section-head ai-reveal"><p class="ai-label">FROM SCREEN TO CLASSROOM</p><h2>从页面到真实使用场景</h2><p>传播内容最终需要进入真实场景，并被真实用户理解与使用。</p></header><div class="ai-field-grid">${picture(img('s3_9','教师端应用指导现场'),'ai-field-tall')}${picture(img('s3_10','入校培训现场'))}${picture(img('s2_6','项目会议现场'))}<blockquote>内容设计的终点，是一线使用者真正理解并开始行动。</blockquote></div></section>
 <section class="ai-teacher ai-wrap"><div class="ai-teacher-panel ai-reveal"><div class="ai-teacher-copy"><p class="ai-label">AI TEACHER ENABLEMENT</p><h2>从课程结构到培训交付</h2><p>围绕教师实际应用场景打磨课程和互动环节，与多部门协同完成课程、宣传与结业物料。</p></div><div class="ai-teacher-visual">${picture(img('s4_3','线上课程实录'))}<span class="ai-orbit ai-orbit-1"><b>26</b> Schools</span><span class="ai-orbit ai-orbit-2"><b>77</b> Teachers</span><span class="ai-orbit ai-orbit-3"><b>5</b> Courses</span><span class="ai-orbit ai-orbit-4"><b>90+</b> Slides</span></div></div></section>
 <section class="ai-agent"><div class="ai-wrap ai-agent-grid"><div class="ai-chat" aria-label="非遗艺术工坊对话示例"><div class="ai-chat-top"><span></span><span></span><span></span><b>非遗艺术工坊</b></div><p class="ai-message ai-user">皮影是怎么动起来的？</p><p class="ai-message ai-assistant" data-chat-answer>皮影人物由头、躯干和四肢组成，艺人通过操纵杆控制关节，让角色在灯光与幕布之间“活”起来。</p></div><div class="ai-agent-copy ai-reveal"><p class="ai-label">AGENT MINI CASE</p><h2>非遗艺术工坊</h2><p>把剪纸、皮影、扎染、木雕等技艺整理成适合中小学生探索的结构化知识库。</p><dl><div><dt>6</dt><dd>非遗技艺</dd></div><div><dt>200+</dt><dd>知识点</dd></div><div><dt>Multi-turn</dt><dd>多轮问答</dd></div><div><dt>Age-aware</dt><dd>分龄内容</dd></div></dl></div></div></section>
 <section class="ai-learning ai-wrap ai-reveal"><p class="ai-label">WHAT THIS PROJECT TAUGHT ME</p><blockquote>好的产品传播并不是简化信息，<br>而是重新设计信息与用户之间的关系。</blockquote><p>从政企汇报、产品推广到教师培训，这段经历让我逐渐建立起：理解对象 → 提炼价值 → 重构信息 → 设计表达 → 落地验证的工作方法。</p><a href="../mazoo/index.html">NEXT PROJECT <span>MAZOO ↗</span></a></section>
 </article>`;
 return shell(p.title,body,base,'work');
};
