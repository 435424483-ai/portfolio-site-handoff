.ai-case{--ai-ink:#141627;--ai-blue:#27386d;--ai-indigo:#6875d8;--ai-peri:#8996ea;--ai-violet:#a68ae8;--ai-mist:#dce5ff;--ai-lav:#eae6fc;--ai-bg:#f7f8fc;--ai-text:#171927;--ai-muted:rgba(23,25,39,.62);--ai-border:rgba(92,102,160,.12);--fast:180ms;--normal:420ms;--slow:700ms;--page:900ms;--ease:cubic-bezier(.22,1,.36,1);background:var(--ai-bg);color:var(--ai-text);overflow:clip}.ai-case h1,.ai-case h2,.ai-case h3{font-weight:500;letter-spacing:-.045em}.ai-wrap{width:min(1400px,90%);margin-inline:auto}.ai-label{font-size:12px;line-height:1.5;letter-spacing:.14em;color:var(--ai-indigo);font-weight:500}.ai-hero{min-height:calc(100vh - 78px);display:grid;grid-template-columns:minmax(0,42fr) minmax(0,58fr);align-items:center;gap:3%;padding:75px max(5vw,calc((100vw - 1500px)/2)) 45px;background:radial-gradient(circle at 72% 8%,rgba(126,142,235,.18),transparent 36%),radial-gradient(circle at 27% 32%,rgba(178,151,235,.14),transparent 35%),var(--ai-bg)}.ai-hero-copy{position:relative;z-index:2}.ai-back{display:inline-flex;margin-bottom:70px;font-size:13px;color:var(--ai-muted);border-bottom:1px solid transparent}.ai-back:hover{color:var(--ai-indigo);border-color:currentColor}.ai-hero h1{font-size:clamp(54px,5.6vw,98px);line-height:.99;margin:20px 0 34px;max-width:800px}.ai-hero h1 span{background:linear-gradient(105deg,var(--ai-indigo),var(--ai-violet));background-clip:text;color:transparent}.ai-lede{max-width:600px;font-size:16px;line-height:1.85;color:var(--ai-muted)}.ai-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}.ai-pills span{padding:9px 14px;border-radius:999px;background:rgba(255,255,255,.58);backdrop-filter:blur(18px) saturate(120%);border:1px solid rgba(255,255,255,.62);box-shadow:inset 0 1px 0 rgba(255,255,255,.7),0 8px 24px rgba(47,54,103,.05);font-size:12px;color:var(--ai-blue)}.ai-canvas{position:relative;height:min(720px,74vh);transform:scale(var(--hero-scale,1)) translateY(var(--hero-y,0));opacity:var(--hero-opacity,1);transition:transform .1s linear,opacity .1s linear}.ai-glow{position:absolute;inset:7% 4%;border-radius:50%;background:radial-gradient(circle,rgba(137,150,234,.28),rgba(166,138,232,.12) 42%,transparent 72%);filter:blur(28px)}.ai-picture{border:0;padding:0;background:transparent;display:block;cursor:zoom-in}.ai-picture img{width:100%;height:100%;object-fit:contain;display:block}.ai-float{position:absolute;border-radius:30px;overflow:hidden;background:#fff;box-shadow:0 24px 80px rgba(52,62,120,.1);transform:translate(var(--px,0),var(--py,0));transition:transform var(--slow) var(--ease),box-shadow var(--normal)}.ai-float:hover{box-shadow:0 28px 90px rgba(52,62,120,.14)}.ai-main{width:63%;height:68%;left:19%;top:15%;z-index:3}.ai-left{width:33%;height:44%;left:0;top:7%;z-index:2}.ai-right{width:35%;height:42%;right:0;top:26%;z-index:4}.ai-bottom{width:37%;height:35%;left:9%;bottom:0;z-index:5}.ai-transition{height:210px;margin-top:-1px;background:linear-gradient(var(--ai-bg),rgba(247,248,252,.72) 45%,#fff)}.ai-overview{display:grid;grid-template-columns:28% 1fr;gap:8%;padding:80px 0 145px}.ai-overview h2{font-size:clamp(34px,4.2vw,68px);line-height:1.14;max-width:1050px;margin:0}.ai-overview dl{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin:70px 0 0;padding-top:24px;border-top:1px solid var(--ai-border)}.ai-overview dt{font-size:11px;letter-spacing:.13em;color:var(--ai-indigo)}.ai-overview dd{margin:12px 0 0;font-size:14px;line-height:1.7;color:var(--ai-muted)}.ai-impact{background:#242949;color:#fff;padding:85px 0 95px;border-radius:52px 52px 0 0}.ai-impact .ai-label{color:#bfc8ff}.ai-impact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:55px 7%;margin-top:42px}.ai-impact-grid>div{display:flex;align-items:baseline;gap:18px;border-top:1px solid rgba(220,229,255,.15);padding-top:18px}.ai-impact-grid strong{font-size:clamp(64px,7vw,96px);line-height:1;font-weight:400;background:linear-gradient(120deg,#fff,#aebaff);background-clip:text;color:transparent}.ai-impact-grid span{font-size:14px;color:rgba(255,255,255,.68)}.ai-audience{padding:150px 0}.ai-section-head{max-width:920px;margin-bottom:70px}.ai-section-head h2{font-size:clamp(40px,5vw,76px);line-height:1.1;margin:20px 0}.ai-section-head>p:not(.ai-label){font-size:17px;color:var(--ai-muted);max-width:650px}.ai-audience-panels{display:flex;gap:16px;min-height:490px}.ai-audience-card{flex:0 1 27%;border:0;text-align:left;padding:38px;border-radius:34px;background:#fff;color:var(--ai-text);box-shadow:0 18px 55px rgba(52,62,120,.06);display:flex;flex-direction:column;align-items:flex-start;transition:flex-basis 750ms var(--ease),background var(--slow),transform var(--normal) var(--ease)}.ai-audience-card[aria-expanded=true]{flex-basis:46%;background:radial-gradient(circle at 80% 10%,rgba(137,150,234,.23),transparent 43%),#fff}.ai-audience-card:hover{transform:translateY(-3px)}.ai-card-no,.ai-card-en{font-size:12px;letter-spacing:.12em;color:var(--ai-indigo)}.ai-card-en{margin-top:auto}.ai-audience-card strong{font-size:clamp(42px,5vw,74px);font-weight:500;margin:12px 0}.ai-card-keys{font-size:15px;color:var(--ai-blue)}.ai-card-text{max-height:0;opacity:0;overflow:hidden;margin-top:0;font-size:15px;line-height:1.8;color:var(--ai-muted);transition:max-height var(--slow) var(--ease),opacity var(--normal),margin var(--normal)}.ai-audience-card[aria-expanded=true] .ai-card-text{max-height:150px;opacity:1;margin-top:25px}.ai-translation{background:#fff;padding:140px 0}.ai-story{display:grid;grid-template-columns:32% 1fr;gap:8%}.ai-story-copy{position:sticky;top:130px;height:max-content}.ai-story-copy h2{font-size:clamp(36px,4vw,60px);line-height:1.15;margin:20px 0}.ai-story-copy>p:last-of-type{font-size:16px;line-height:1.8;color:var(--ai-muted);max-width:380px}.ai-story-copy nav{display:grid;margin-top:45px}.ai-story-copy nav a{display:flex;gap:16px;padding:13px 0;border-bottom:1px solid var(--ai-border);font-size:14px;color:var(--ai-muted)}.ai-story-copy nav a.is-active{color:var(--ai-indigo)}.ai-story-step{min-height:88vh;padding:40px 0 110px;display:flex;flex-direction:column;justify-content:center}.ai-step-copy span{font-size:11px;letter-spacing:.12em;color:var(--ai-indigo)}.ai-step-copy h3{font-size:clamp(29px,3vw,44px);margin:14px 0}.ai-step-copy p{color:var(--ai-muted);max-width:620px;line-height:1.8}.ai-raw{height:480px;position:relative;margin-top:40px;border-radius:36px;background:linear-gradient(145deg,#eef1fa,#fafaff);overflow:hidden}.ai-raw .ai-picture{position:absolute;width:55%;height:66%;padding:14px;border-radius:24px;background:#fff;box-shadow:0 20px 55px rgba(52,62,120,.09)}.ai-raw .ai-picture:nth-child(1){left:5%;top:8%}.ai-raw .ai-picture:nth-child(2){right:5%;bottom:6%}.ai-raw .ai-picture:nth-child(3){width:34%;height:58%;right:10%;top:4%}.ai-flow{list-style:none;padding:45px;margin:40px 0 0;border-radius:36px;background:linear-gradient(145deg,#f1f3fc,#fbfbff);display:grid;gap:12px}.ai-flow li{position:relative;display:flex;align-items:center;gap:20px;padding:17px 22px;border-radius:999px;background:rgba(255,255,255,.7);color:var(--ai-blue)}.ai-flow li:not(:last-child):after{content:'↓';position:absolute;bottom:-18px;left:50%;color:#a4afe2;z-index:2}.ai-flow span{font-size:11px;color:var(--ai-indigo)}.ai-flow b{font-size:16px;font-weight:500}.ai-final-comms{display:grid;grid-template-columns:1.45fr 1fr;gap:18px;margin-top:40px}.ai-final-comms .ai-picture{height:270px;padding:12px;border-radius:28px;background:#f3f5fb;overflow:hidden}.ai-final-comms .ai-picture:first-child{grid-row:span 2;height:558px}.ai-presentation{padding:150px 0}.ai-featured{padding:45px;border-radius:44px;background:radial-gradient(circle at 60% 20%,rgba(137,150,234,.2),transparent 44%),#eef1fb}.ai-featured-main{width:80%;height:min(690px,65vw);margin:auto;border-radius:32px;overflow:hidden;background:#fff;box-shadow:0 24px 70px rgba(52,62,120,.08)}.ai-film-head{display:flex;justify-content:space-between;align-items:center;margin:34px 0 16px;font-size:11px;letter-spacing:.12em;color:var(--ai-muted)}.ai-film-head button{width:44px;height:44px;border-radius:50%;border:1px solid var(--ai-border);background:rgba(255,255,255,.58);backdrop-filter:blur(18px)}.ai-film{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:14px;scrollbar-width:thin}.ai-film .ai-picture{flex:0 0 min(62vw,620px);height:360px;border-radius:28px;overflow:hidden;background:#fff;scroll-snap-align:start;transition:transform var(--normal) var(--ease)}.ai-film .ai-picture:hover{transform:scale(1.015)}.ai-versions{padding:140px 0;background:linear-gradient(#f3f5fb,#e9edfa)}.ai-version-stack{width:min(930px,100%);margin:auto}.ai-version{position:sticky;top:105px;min-height:600px;margin-bottom:95px;padding:30px;border-radius:40px;background:rgba(255,255,255,.9);box-shadow:0 24px 70px rgba(52,62,120,.08);display:grid;grid-template-columns:180px 1fr;gap:25px;transform:translateY(calc(var(--version)*16px))}.ai-version>div span{font-size:60px;color:var(--ai-indigo)}.ai-version>div p{font-size:14px;line-height:1.7;color:var(--ai-muted);margin-top:15px}.ai-version .ai-picture{height:540px;border-radius:30px;overflow:hidden;background:#f2f4fa}.ai-field{padding:160px 0}.ai-field-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:330px 330px;gap:20px}.ai-field-grid .ai-picture{border-radius:34px;overflow:hidden;background:#eef1f8}.ai-field-grid .ai-picture img{object-fit:cover}.ai-field-tall{grid-row:span 2}.ai-field-grid blockquote{margin:0;padding:45px;border-radius:34px;background:var(--ai-blue);color:#fff;font-size:clamp(23px,2.6vw,38px);line-height:1.35;display:flex;align-items:flex-end}.ai-teacher{padding-bottom:160px}.ai-teacher-panel{min-height:720px;border-radius:52px;background:radial-gradient(circle at 75% 22%,rgba(166,138,232,.18),transparent 35%),linear-gradient(135deg,#eef3ff,#f5f1fc);padding:65px;display:grid;grid-template-columns:38% 1fr;align-items:center;gap:6%}.ai-teacher-copy h2{font-size:clamp(38px,4vw,62px);line-height:1.12;margin:20px 0}.ai-teacher-copy>p:last-child{line-height:1.8;color:var(--ai-muted)}.ai-teacher-visual{height:570px;position:relative;display:grid;place-items:center}.ai-teacher-visual>.ai-picture{width:62%;height:72%;border-radius:35px;background:#fff;box-shadow:0 24px 70px rgba(52,62,120,.08);padding:15px;overflow:hidden}.ai-orbit{position:absolute;padding:13px 18px;border-radius:999px;background:rgba(255,255,255,.65);backdrop-filter:blur(18px);box-shadow:0 8px 24px rgba(47,54,103,.07);font-size:12px;color:var(--ai-muted)}.ai-orbit b{font-size:26px;color:var(--ai-indigo);margin-right:7px}.ai-orbit-1{left:1%;top:16%}.ai-orbit-2{right:0;top:25%}.ai-orbit-3{left:5%;bottom:14%}.ai-orbit-4{right:4%;bottom:11%}.ai-agent{padding:150px 0;background:#f0edfb}.ai-agent-grid{display:grid;grid-template-columns:1fr 1fr;gap:8%;align-items:center}.ai-chat{min-height:520px;padding:25px;border-radius:40px;background:rgba(255,255,255,.72);box-shadow:0 24px 70px rgba(52,62,120,.08)}.ai-chat-top{display:flex;gap:7px;align-items:center;padding-bottom:22px;border-bottom:1px solid var(--ai-border)}.ai-chat-top span{width:8px;height:8px;border-radius:50%;background:#cad0eb}.ai-chat-top b{margin-left:auto;font-size:12px;font-weight:500;color:var(--ai-muted)}.ai-message{width:80%;padding:18px 21px;border-radius:24px;font-size:15px;line-height:1.75;margin-top:42px}.ai-user{margin-left:auto;background:var(--ai-blue);color:#fff;border-bottom-right-radius:8px}.ai-assistant{background:#fff;color:var(--ai-text);border-bottom-left-radius:8px;opacity:0;transform:translateY(15px)}.ai-assistant.is-shown{animation:ai-message-in var(--slow) var(--ease) forwards}.ai-agent-copy h2{font-size:clamp(42px,5vw,72px);margin:20px 0}.ai-agent-copy>p:not(.ai-label){line-height:1.8;color:var(--ai-muted);max-width:600px}.ai-agent-copy dl{display:grid;grid-template-columns:1fr 1fr;margin-top:45px;gap:28px}.ai-agent-copy dl div{border-top:1px solid var(--ai-border);padding-top:15px}.ai-agent-copy dt{font-size:31px;color:var(--ai-indigo)}.ai-agent-copy dd{margin:6px 0 0;font-size:13px;color:var(--ai-muted)}.ai-learning{padding:160px 0 110px}.ai-learning blockquote{font-size:clamp(42px,5.5vw,82px);line-height:1.14;letter-spacing:-.045em;margin:35px 0 55px;max-width:1200px}.ai-learning>p:not(.ai-label){max-width:760px;color:var(--ai-muted);line-height:1.9;font-size:17px}.ai-learning>a{margin-top:100px;padding-top:25px;border-top:1px solid var(--ai-border);display:flex;justify-content:space-between;font-size:12px;letter-spacing:.12em}.ai-learning>a span{font-size:28px;letter-spacing:0;color:var(--ai-indigo)}.ai-reveal{opacity:0;transform:translateY(24px)}.ai-reveal.is-visible{opacity:1;transform:none;transition:opacity var(--slow) var(--ease),transform var(--slow) var(--ease)}@keyframes ai-message-in{to{opacity:1;transform:none}}
body:has(.ai-case)>.site-header{position:fixed;top:18px;left:50%;transform:translateX(-50%);width:min(920px,calc(100% - 32px));min-height:56px;border:1px solid rgba(255,255,255,.42);border-radius:999px;background:rgba(255,255,255,var(--ai-nav-alpha,.45));backdrop-filter:blur(var(--ai-nav-blur,12px)) saturate(120%);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 8px 24px rgba(47,54,103,.07);padding:9px 20px;transition:background var(--normal),backdrop-filter var(--normal)}body:has(.ai-case)>.site-header .availability{display:none}body:has(.ai-case)>.site-header:after{display:none}body:has(.ai-case)>.site-header nav{margin-left:auto}body:has(.ai-case)>.site-header .brand{font-size:18px}
@media(max-width:900px){.ai-hero{grid-template-columns:1fr;padding-top:130px}.ai-hero-copy{order:0}.ai-canvas{height:600px}.ai-back{margin-bottom:45px}.ai-overview{grid-template-columns:1fr;padding-bottom:100px}.ai-overview h2{margin-top:20px}.ai-impact-grid{gap:40px 4%}.ai-story{grid-template-columns:1fr}.ai-story-copy{position:static}.ai-story-copy nav{display:none}.ai-story-step{min-height:0;padding-block:70px}.ai-audience-card{padding:28px}.ai-teacher-panel{grid-template-columns:1fr}.ai-field-grid{grid-template-rows:280px 280px}}
@media(max-width:700px){.ai-wrap{width:89%}.ai-hero{display:flex;flex-direction:column;align-items:stretch;min-height:auto;padding:115px 5.5% 35px}.ai-hero h1{font-size:clamp(44px,13vw,62px);line-height:1.03}.ai-back{margin-bottom:35px}.ai-canvas{height:440px;margin-top:20px}.ai-main{width:65%;left:18%}.ai-left{width:37%}.ai-right{width:38%}.ai-bottom{width:40%}.ai-transition{height:145px}.ai-overview{padding:40px 0 90px}.ai-overview h2{font-size:36px}.ai-overview dl{grid-template-columns:1fr;gap:20px;margin-top:45px}.ai-impact{border-radius:34px 34px 0 0;padding:65px 0}.ai-impact-grid{grid-template-columns:1fr 1fr;gap:32px 18px}.ai-impact-grid>div{display:block}.ai-impact-grid strong{font-size:55px}.ai-impact-grid span{display:block;margin-top:8px}.ai-audience{padding:95px 0}.ai-audience-panels{overflow-x:auto;scroll-snap-type:x mandatory;min-height:420px;padding:0 7% 16px 0}.ai-audience-card,.ai-audience-card[aria-expanded=true]{flex:0 0 82%;scroll-snap-align:start}.ai-audience-card .ai-card-text{max-height:170px;opacity:1;margin-top:22px}.ai-section-head{margin-bottom:45px}.ai-section-head h2{font-size:40px}.ai-translation{padding:80px 0}.ai-story-step{padding:55px 0}.ai-raw{height:370px}.ai-final-comms{grid-template-columns:1fr}.ai-final-comms .ai-picture:first-child{grid-row:auto;height:330px}.ai-final-comms .ai-picture{height:280px}.ai-presentation{padding:90px 0}.ai-featured{padding:16px;border-radius:30px}.ai-featured-main{width:100%;height:340px;border-radius:23px}.ai-film .ai-picture{flex-basis:84vw;height:280px}.ai-versions{padding:90px 0}.ai-version{top:90px;grid-template-columns:1fr;min-height:auto;padding:18px;border-radius:28px}.ai-version>div{display:flex;justify-content:space-between;align-items:end}.ai-version>div span{font-size:42px}.ai-version .ai-picture{height:460px;border-radius:22px}.ai-field{padding:95px 0}.ai-field-grid{display:flex;flex-direction:column}.ai-field-grid .ai-picture{height:290px}.ai-field-grid .ai-field-tall{height:470px}.ai-field-grid blockquote{min-height:240px}.ai-teacher{padding-bottom:95px}.ai-teacher-panel{padding:32px 22px;border-radius:34px}.ai-teacher-visual{height:470px}.ai-teacher-visual>.ai-picture{width:75%;height:65%}.ai-orbit{padding:9px 12px}.ai-orbit b{font-size:21px}.ai-agent{padding:90px 0}.ai-agent-grid{grid-template-columns:1fr}.ai-chat{min-height:420px;order:2;margin-top:35px}.ai-agent-copy h2{font-size:46px}.ai-learning{padding:100px 0 75px}.ai-learning blockquote{font-size:43px}.ai-learning>a{margin-top:70px}.ai-learning>a span{font-size:22px}body:has(.ai-case)>.site-header{top:10px;width:calc(100% - 20px);padding-inline:14px}body:has(.ai-case)>.site-header nav{top:64px;border-radius:20px}}
@media(prefers-reduced-motion:reduce){.ai-reveal{opacity:1;transform:none}.ai-float,.ai-canvas,.ai-picture{transition:none!important}.ai-assistant{opacity:1;transform:none}.ai-assistant.is-shown{animation:none}}
